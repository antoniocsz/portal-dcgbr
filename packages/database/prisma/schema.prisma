// Prisma schema do @digimon/database — dono único do schema no monorepo.
// Tabelas base v1 (auth/users, content, comments, cards). decks/tournaments
// entram quando os módulos forem criados.
//
// Prisma 7: generator `prisma-client` com output LOCAL (src/generated/prisma) e
// driver adapter (@prisma/adapter-pg). A URL do banco não vive aqui — o CLI a
// lê do prisma.config.ts e o runtime a recebe via adapter (src/client.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  EDITOR
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostCategory {
  NEWS
  ARTICLE
  CURIOSITY
  SIMULATOR
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CommentTargetType {
  POST
  CARD
  DECK
}

enum TournamentStatus {
  PUBLISHED
  CANCELLED
  FINISHED
}

enum DeckStatus {
  DRAFT
  PUBLISHED
}

enum CardType {
  DIGIMON
  OPTION
  TAMER
}

enum CardColor {
  RED
  BLUE
  YELLOW
  GREEN
  PURPLE
  BLACK
  WHITE
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  avatarUrl           String?
  passwordHash        String
  role                Role                 @default(MEMBER)
  emailVerifiedAt     DateTime?
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  posts               Post[]
  comments            Comment[]
  tournaments         Tournament[]
  decks               Deck[]
  deckCopies          DeckCopy[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String?
  body        String
  coverImage  String?
  category    PostCategory
  status      PostStatus   @default(DRAFT)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Comment {
  id         String            @id @default(cuid())
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  targetType CommentTargetType
  targetId   String
  body       String
  status     CommentStatus     @default(VISIBLE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([targetType, targetId])
}

model Tournament {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  organizerId String
  organizer   User             @relation(fields: [organizerId], references: [id])
  description String?
  format      String
  location    String
  dateStart   DateTime
  dateEnd     DateTime?
  status      TournamentStatus @default(PUBLISHED)
  results     Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, dateStart])
  @@index([format])
  @@index([location])
}

// Deckbuilder (@digimon/decks) — colaborativo: Member publica decks próprios
// direto (sem revisão). cardList é JSON (cardId + quantity) validado contra as
// Cartas do @digimon/cards. Rascunhos visíveis só ao dono.
model Deck {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id])
  description String?
  cardList    Json
  format      String
  status      DeckStatus @default(DRAFT)
  isPublic    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  copies      DeckCopy[]

  @@index([status, isPublic])
  @@index([ownerId])
  @@index([format])
  @@map("decks")
}

model DeckCopy {
  id           String   @id @default(cuid())
  sourceDeckId String
  sourceDeck   Deck     @relation(fields: [sourceDeckId], references: [id], onDelete: Cascade)
  copiedById   String
  copiedBy     User     @relation(fields: [copiedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([sourceDeckId])
  @@index([copiedById])
  @@map("deck_copies")
}

// Card database (@digimon/cards) — catálogo público, escrita só admin/curadoria.
// O índice GIN de full-text é criado via SQL na migration (to_tsvector name+effects).
model CardSet {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("card_sets")
}

model Card {
  id                  String      @id @default(cuid())
  dcgId               String      @unique
  name                String
  number              String
  rarity              String
  type                CardType
  colors              CardColor[]
  level               Int?
  digiType            String?
  attribute           String?
  dp                  Int?
  playCost            Int?
  evolutionConditions Json        @default("[]")
  effects             String?
  imageUrl            String?
  setCode             String?
  releaseDate         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([type])
  @@index([setCode])
  @@map("cards")
}