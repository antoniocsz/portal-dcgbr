// Prisma schema do @digimon/database — dono único do schema no monorepo.
// Tabelas base v1 (auth/users, content, comments, cards). decks/tournaments
// entram quando os módulos forem criados.
//
// Prisma 7: generator `prisma-client` com output LOCAL (src/generated/prisma) e
// driver adapter (@prisma/adapter-pg). A URL do banco não vive aqui — o CLI a
// lê do prisma.config.ts e o runtime a recebe via adapter (src/client.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMINISTRATOR
  EDITOR
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostCategory {
  NEWS
  ARTICLE
  CURIOSITY
  SIMULATOR
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum CommentTargetType {
  POST
  CARD
  DECK
}

enum TournamentStatus {
  PUBLISHED
  CANCELLED
  FINISHED
}

enum DeckStatus {
  DRAFT
  PUBLISHED
}

enum PublicDeckStatus {
  PUBLIC
  HIDDEN
  UNPUBLISHED
}

enum CardType {
  DIGIMON
  OPTION
  TAMER
  DIGIEGG
}

enum CardColor {
  RED
  BLUE
  YELLOW
  GREEN
  PURPLE
  BLACK
  WHITE
}

enum AdKind {
  HOUSE
  AFFILIATE
  SPONSOR
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  avatarUrl           String?
  passwordHash        String
  role                Role                 @default(MEMBER)
  emailVerifiedAt     DateTime?
  status              UserStatus           @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  posts               Post[]
  comments            Comment[]
  tournaments         Tournament[]
  decks               Deck[]
  deckCopies          DeckCopy[]
  publicDecks         PublicDeck[]         @relation("PublicDecks")
  publicDeckLikes     PublicDeckLike[]     @relation("PublicDeckLikes")
  publicDeckCopies    PublicDeckCopy[]     @relation("PublicDeckCopies")
  deckReports         CommunityDeckReport[] @relation("DeckReports")
  createdAds          Ad[]                 @relation("AdCreator")
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  excerpt     String?
  body        String
  coverImage  String?
  externalUrl String?
  category    PostCategory
  status      PostStatus   @default(DRAFT)
  authorId    String
  author      User         @relation(fields: [authorId], references: [id])
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Comment {
  id         String            @id @default(cuid())
  authorId   String
  author     User              @relation(fields: [authorId], references: [id])
  targetType CommentTargetType
  targetId   String
  body       String
  status     CommentStatus     @default(VISIBLE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([targetType, targetId])
}

/// Par de chave/valor para configurações do site (ex.: modo "em breve").
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Tournament {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  organizerId String
  organizer   User             @relation(fields: [organizerId], references: [id])
  description String?
  format      String
  location    String
  dateStart   DateTime
  dateEnd     DateTime?
  status      TournamentStatus @default(PUBLISHED)
  results     Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, dateStart])
  @@index([format])
  @@index([location])
}

// Deckbuilder (@digimon/decks) — colaborativo: Member publica decks próprios
// direto (sem revisão). cardList/eggList são JSON (cardId + quantity) validados
// contra as Cartas do @digimon/cards. Rascunhos visíveis só ao dono.
model Deck {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  ownerId      String
  owner        User         @relation(fields: [ownerId], references: [id])
  description  String?
  cardList     Json
  eggList      Json         @default("[]")
  coverCardId  String?
  format       String
  status       DeckStatus   @default(DRAFT)
  isPublic     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  copies       DeckCopy[]
  publications PublicDeck[]

  @@index([status, isPublic])
  @@index([ownerId])
  @@index([format])
  @@map("decks")
}

model DeckCopy {
  id           String   @id @default(cuid())
  sourceDeckId String
  sourceDeck   Deck     @relation(fields: [sourceDeckId], references: [id], onDelete: Cascade)
  copiedById   String
  copiedBy     User     @relation(fields: [copiedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([sourceDeckId])
  @@index([copiedById])
  @@map("deck_copies")
}

// Card database (@digimon/cards) — catálogo público, escrita só admin/curadoria.
// O índice GIN de full-text é criado via SQL na migration (to_tsvector name+effects).
model CardSet {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  releaseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("card_sets")
}

model Card {
  id                  String      @id @default(cuid())
  dcgId               String      @unique
  name                String
  number              String
  rarity              String
  type                CardType
  colors              CardColor[]
  level               Int?
  digiType            String?
  attribute           String?
  dp                  Int?
  playCost            Int?
  evolutionConditions Json        @default("[]")
  effects             String?
  imageUrl            String?
  setCode             String?
  releaseDate         DateTime?
  maxCountInDeck      Int         @default(4)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([type])
  @@index([setCode])
  @@map("cards")
}

// Comunidade de decks (@digimon/decks) — snapshot congelado de um deck publicado
// pelo Member, com engajamento (likes/cópias) e moderação (reportes). O snapshot
// não acompanha edições do deck de origem; `sourceDeckId` aponta para a origem.
model PublicDeck {
  id           String           @id @default(cuid())
  accountId    String
  account      User             @relation("PublicDecks", fields: [accountId], references: [id])
  sourceDeckId String
  sourceDeck   Deck             @relation(fields: [sourceDeckId], references: [id], onDelete: Cascade)
  name         String
  colors       Json             @default("[]")
  cardList     Json
  eggList      Json             @default("[]")
  coverCardId  String?
  likeCount    Int              @default(0)
  copyCount    Int              @default(0)
  status       PublicDeckStatus @default(PUBLIC)
  publishedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  likes        PublicDeckLike[]
  copies       PublicDeckCopy[]
  reports      CommunityDeckReport[]

  @@unique([accountId, sourceDeckId])
  @@index([status, likeCount])
  @@index([status, publishedAt])
  @@map("public_decks")
}

model PublicDeckLike {
  id           String     @id @default(cuid())
  publicDeckId String
  publicDeck   PublicDeck @relation(fields: [publicDeckId], references: [id], onDelete: Cascade)
  accountId    String
  account      User       @relation("PublicDeckLikes", fields: [accountId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([publicDeckId, accountId])
  @@map("public_deck_likes")
}

model PublicDeckCopy {
  id           String     @id @default(cuid())
  publicDeckId String
  publicDeck   PublicDeck @relation(fields: [publicDeckId], references: [id], onDelete: Cascade)
  accountId    String
  account      User       @relation("PublicDeckCopies", fields: [accountId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([publicDeckId, accountId])
  @@map("public_deck_copies")
}

model CommunityDeckReport {
  id                String     @id @default(cuid())
  publicDeckId      String
  publicDeck        PublicDeck @relation(fields: [publicDeckId], references: [id], onDelete: Cascade)
  reporterAccountId String?
  reporter          User?      @relation("DeckReports", fields: [reporterAccountId], references: [id], onDelete: SetNull)
  reason            String
  details           String?
  createdAt         DateTime   @default(now())
  dismissedAt       DateTime?

  @@index([publicDeckId, dismissedAt])
  @@map("community_deck_reports")
}

// Anúncios/patrocínios do portal (@digimon/ads): house ads, patrocínio direto e
// links de afiliado. `placements` é lista escalar de posições de exibição;
// `impressions`/`clicks` são contadores simples (sem PII). Curadoria: administrator.
model Ad {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  imageUrl     String?
  targetUrl    String
  kind         AdKind
  placements   String[]
  ctaLabel     String?
  sponsorName  String?
  disclosure   String?
  isActive     Boolean  @default(true)
  priority     Int      @default(0)
  startAt      DateTime?
  endAt        DateTime?
  openInNewTab Boolean  @default(true)
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  createdBy    String
  creator      User     @relation("AdCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([kind])
  @@map("ads")
}