# =============================================================================
# API (apps/api) — Fastify. Copie para apps/api/.env (dev) ou defina no Coolify.
# O entrypoint roda `prisma migrate deploy` + seed antes de subir o servidor.
# =============================================================================

# Servidor HTTP da API
HOST=0.0.0.0
PORT=3001

# Banco — obrigatória. Em produção use o host do serviço (ex.: postgres:5432).
# Formato: postgresql://<user>:<password>@<host>:5432/<db>
DATABASE_URL=postgresql://digimon:digimon@localhost:5432/digimon

# Segredo JWT — mínimo 32 caracteres. Gere com: openssl rand -base64 48
# MESMO valor usado no web (os dois compartilham a sessão).
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# CORS — allowlist de origens do web, separadas por vírgula (nunca use "*").
# Sem valor, nenhuma origem cross-origin é liberada (default seguro).
CORS_ORIGIN=https://digimoncardgamebrasil.com.br,https://www.digimoncardgamebrasil.com.br

# Cookie de sessão — domínio compartilhado entre web e api (subdomínios same-site).
# Em produção o default é .digimoncardgamebrasil.com.br; vazio = sem Domain (dev/localhost).
COOKIE_DOMAIN=.digimoncardgamebrasil.com.br

# Seed — `true` pula o seed do entrypoint (default: roda o seed guardado `--only-if-empty`).
SKIP_SEED=false

# Seed — administrador inicial, usado SOMENTE quando o banco está vazio.
# Em produção defina uma senha forte (o default abaixo é de dev).
ADMIN_EMAIL=admin@digimoncardgamebrasil.com.br
ADMIN_PASSWORD=admin12345
