{
  "name": "@digimon/app-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.mjs --external:fastify --external:pg --external:@prisma/client --external:@prisma/client/* --external:@prisma/adapter-pg",
    "start": "node --env-file-if-exists=.env dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@digimon/ads": "workspace:*",
    "@digimon/auth": "workspace:*",
    "@digimon/cards": "workspace:*",
    "@digimon/comments": "workspace:*",
    "@digimon/content": "workspace:*",
    "@digimon/contracts": "workspace:*",
    "@digimon/database": "workspace:*",
    "@digimon/decks": "workspace:*",
    "@digimon/tournaments": "workspace:*",
    "@digimon/users": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.5",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
