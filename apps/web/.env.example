# O Next.js NÃO lê o .env da raiz — copie para apps/web/.env
# Frontend puro (ADR-007): o web fala com a API separada; NÃO acessa banco (sem DATABASE_URL).

# URL pública da API, usada no BROWSER (CORS + cookie de sessão compartilhados).
# ⚠️ É embutida em BUILD TIME (prefixo NEXT_PUBLIC_): no Coolify marque "available at buildtime".
NEXT_PUBLIC_API_URL=https://api.digimoncardgamebrasil.com.br

# Endereço INTERNO da API na rede do Coolify, usado no SSR/middleware (proxy.ts, páginas [slug]/[id]).
# Default do código: http://api:3001 — ajuste se o serviço da API tiver outro nome interno.
API_INTERNAL_URL=http://api:3001

# Sessão admin server-side (valida o access_token no servidor). MESMO segredo da API.
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres

# Porta do servidor Next standalone (default da imagem: 3000).
PORT=3000
